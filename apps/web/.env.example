# ── Autorotate web app environment ──────────────────────────────────
# Copy to .env and fill in real values. NEVER commit a real .env.

# ── Database ─────────────────────────────────────────────────────
# MySQL connection string used by Drizzle ORM.
DATABASE_URL=mysql://user:password@localhost:3306/autorotate

# ── Autorotate backend ──────────────────────────────────────────────
# Console admin token. REQUIRED in production — the server refuses to start
# without it, because the console has no other credential. In development an
# ephemeral token is minted and printed at boot when this is unset.
# Generate with: openssl rand -hex 32
AUTOROTATE_ADMIN_TOKEN=

# Demo mode. OFF unless this is exactly "1" or "true" — anything else
# (including unset, "" and "0") runs real rotations against real providers.
AUTOROTATE_DEMO=0

# 32-byte hex key used to encrypt stored credentials at rest.
# REQUIRED in production; without it the development passphrase published in
# this repository would protect your connector admin credentials.  Leave this
# BLANK and generate a real key — a placeholder key (e.g. all zeros) is a valid
# AES key and is rejected at startup, so committing one is never safe.
# Generate with: openssl rand -hex 32
AUTOROTATE_ENC_KEY=

# Filesystem root for file-based rotation targets.
AUTOROTATE_FILE_ROOT=./autorotate-files

# Run the rotation scheduler outside production. Off by default so a laptop
# pointed at a shared database does not rotate production secrets.
AUTOROTATE_SCHEDULER=0

# ── Platform ─────────────────────────────────────────────────────
APP_ID=your-app-id
APP_SECRET=your-app-secret
VITE_APP_ID=your-app-id
