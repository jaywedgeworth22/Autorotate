# Dependencies
node_modules/

# Build output
dist/
.build/
DerivedData/

# Environment & secrets — never commit real env files
.env
.env.*
!.env.example

# Apple / Xcode
*.xcworkspace
xcuserdata/
**/*.xcodeproj/project.xcworkspace/
**/*.xcodeproj/xcuserdata/

# Autorotate local file targets
autorotate-files/

# Logs
*.log

# OS noise
.DS_Store

# XcodeGen output — regenerate with `xcodegen generate`
apple/Autorotate.xcodeproj/
apple/Autorotate.xcodeproj/

# Android build output
android/.gradle/
android/build/
android/app/build/
android/local.properties
local.properties
.gradle/
releases/

# Root-level build output (e.g. Apple archives / dSYMs exported to ./build)
build/

# Android release signing — never commit keystores or credentials
android/keystore.properties
*.keystore
*.jks

