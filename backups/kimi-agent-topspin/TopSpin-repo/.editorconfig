root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# JS/TS/YAML/JSON — 2 spaces
[*.{js,jsx,ts,tsx,json,yml,yaml,css,html}]
indent_style = space
indent_size = 2

# Swift — 4 spaces
[*.swift]
indent_style = space
indent_size = 4

# Markdown — keep trailing whitespace (hard breaks)
[*.md]
trim_trailing_whitespace = false

# Makefiles need tabs
[Makefile]
indent_style = tab
