<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Autorotate iOS Info.plist.

  This file carries the keys that cannot be expressed as INFOPLIST_KEY_*
  build settings (arrays): the BGTaskScheduler permitted identifiers and
  background modes for `com.autorotate.refresh` (see BackgroundRotation.swift).
  project.yml sets GENERATE_INFOPLIST_FILE = YES, so Xcode MERGES this file
  with the INFOPLIST_KEY_* build settings (display name, orientations,
  launch screen) at build time.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <!-- Background rotation: BGAppRefreshTask "codes.autorotate.refresh". -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>codes.autorotate.refresh</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
    </array>

    <key>NSFaceIDUsageDescription</key>
    <string>Autorotate uses Face ID to securely authenticate and protect your API secrets.</string>
    <key>NSCameraUsageDescription</key>
    <string>Autorotate uses the camera to scan Web Control Center pairing QR codes.</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- Empty unless xcodebuild/CI passes SENTRY_DSN=... -->
    <key>SENTRY_DSN</key>
    <string>$(SENTRY_DSN)</string>
</dict>
</plist>

