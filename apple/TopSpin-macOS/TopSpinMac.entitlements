<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TopSpinMac.entitlements — TopSpin macOS app.

  CAPABILITIES
  ------------
  1. App Sandbox (com.apple.security.app-sandbox)
     The app is fully sandboxed; all file access is user-granted.

  2. User-selected file read/write
     (com.apple.security.files.user-selected.read-write)
     File targets (~/.aws/credentials, .env files, config.json, …) are
     picked via NSOpenPanel or drag-and-drop. This entitlement permits
     read AND write of exactly those user-selected files — TopSpin
     rewrites them atomically (tmp + rename) during rotation PUSH.

  3. Security-scoped bookmarks
     (com.apple.security.files.bookmarks.app-scope)
     Required to persist access to user-picked files across launches via
     URL.bookmarkData(options: .withSecurityScope). Without it, scheduled
     background rotations would lose access to file targets once the
     picker session ends. See TopSpin-macOS/Bookmarks.swift.

  4. Outgoing network (com.apple.security.network.client)
     Connector APIs (AWS/Stripe/GitHub/…), Infisical REST, webhooks.

  5. Keychain Sharing (keychain-access-groups)
     Shares managed secrets, admin credentials and the Infisical
     clientSecret with the iOS app / extensions via
     $(AppIdentifierPrefix)codes.autorotate.shared. Also required on macOS 14+
     for kSecAttrSynchronizable (iCloud Keychain) items — used only when
     the user enables "Sync via iCloud Keychain" ("if allowed").
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)codes.autorotate.shared</string>
    </array>
</dict>
</plist>
